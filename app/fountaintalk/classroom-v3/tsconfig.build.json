{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "engine/**/*.ts",
    "story/**/*.ts",
    "content/**/*.ts",
    "learner-os/**/*.ts",
    "mentor/**/*.ts",
    "studio/core/**/*.ts"
  ]
}